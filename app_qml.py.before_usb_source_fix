                percent,
                speed,
                eta
            )

        except Exception as e:
            print("TRANSFER WINDOW ERROR:", e)


    def _transfer_status(self, text):

        try:
            self.transfer_window.show()
            self.transfer_window.set_status(text)

        except Exception as e:
            print("TRANSFER STATUS ERROR:", e)


    def _transfer_log(self, text):

