import QtQuick
import QtQuick.Controls
import QtQuick.Layouts
import "../components"

Item {

    id: root

    anchors.fill: parent

    Rectangle {

        anchors.fill: parent

        color: "#070910"

    }


    Flickable {

        anchors.fill: parent

        anchors.margins: 30

        contentWidth: width

        contentHeight: contentColumn.height + 30

        clip: true


        Column {

            id: contentColumn

            width: parent.width

            spacing: 22


            // =====================================================
            // SECTION HEADER
            // =====================================================

            RowLayout {

                width: parent.width
                height: 45

                ColumnLayout {

                    Layout.fillWidth: true
                    spacing: 2

                    Text {
                        text: "\u0645\u0643\u062a\u0628\u0629 \u0627\u0644\u0623\u0644\u0639\u0627\u0628"
                        color: "#FFFFFF"
                        font.pixelSize: 21
                        font.bold: true
                    }

                    Text {
                        text: "\u0627\u062e\u062a\u0631 \u0627\u0644\u0644\u0639\u0628\u0629 \u0627\u0644\u062a\u064a \u062a\u0631\u064a\u062f \u0646\u0642\u0644\u0647\u0627 \u0623\u0648 \u062a\u062b\u0628\u064a\u062a\u0647\u0627"
                        color: "#697386"
                        font.pixelSize: 12
                    }

                }

                Rectangle {

                    Layout.preferredWidth: 120
                    Layout.preferredHeight: 36
                    radius: 9
                    color: "#101720"
                    border.width: 1
                    border.color: "#21303A"

                    Text {
                        anchors.centerIn: parent
                        text: "7 \u0623\u0644\u0639\u0627\u0628"
                        color: "#00D9FF"
                        font.pixelSize: 12
                        font.bold: true
                    }

                }

            }


            // GAMES GRID
            // =====================================================

            Grid {

                id: grid

                width: parent.width

                columns: width >= 1250 ? 4 : width >= 850 ? 3 : 2

                spacing: 22


                GameCard {

                    gameName: "Fortnite"

                    imageSource: "file:///D:/KAFIA_NET_CONTROL_PRO_PC/assets/games/fortnite.png"

                    gameColor: "#2D8CFF"

                }


                GameCard {

                    gameName: "Genshin Impact"

                    imageSource: "file:///D:/KAFIA_NET_CONTROL_PRO_PC/assets/games/genshin.png"

                    gameColor: "#8A5CFF"

                }


                GameCard {

                    gameName: "eFootball"

                    imageSource: "file:///D:/KAFIA_NET_CONTROL_PRO_PC/assets/games/efootball.png"

                    gameColor: "#00B894"

                }


                GameCard {

                    gameName: "Free Fire"

                    imageSource: "file:///D:/KAFIA_NET_CONTROL_PRO_PC/assets/games/freefire.png"

                    gameColor: "#FF9F1C"

                }


                GameCard {

                    gameName: "PUBG Mobile"

                    imageSource: "file:///D:/KAFIA_NET_CONTROL_PRO_PC/assets/games/pubg.png"

                    gameColor: "#F5C542"

                }


                GameCard {

                    gameName: "Call of Duty Mobile"

                    imageSource: "file:///D:/KAFIA_NET_CONTROL_PRO_PC/assets/games/callofduty.png"

                    gameColor: "#FF4D4D"

                }


                GameCard {

                    gameName: "Grand Theft Auto"

                    imageSource: "file:///D:/KAFIA_NET_CONTROL_PRO_PC/assets/games/gta.png"

                    gameColor: "#9B59B6"

                }

            }

        }

    }

}
