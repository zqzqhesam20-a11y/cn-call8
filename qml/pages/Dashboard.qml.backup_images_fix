import QtQuick
import QtQuick.Controls
import QtQuick.Layouts
import "../components"

Item {

    id: root

    anchors.fill: parent

    Rectangle {

        anchors.fill: parent

        color: "#070910"

    }


    Flickable {

        anchors.fill: parent

        anchors.margins: 30

        contentWidth: width

        contentHeight: contentColumn.height + 30

        clip: true


        Column {

            id: contentColumn

            width: parent.width

            spacing: 22


            // =====================================================
            // GAMES GRID
            // =====================================================

            Grid {

                id: grid

                width: parent.width

                columns: width >= 1250 ? 4 : width >= 850 ? 3 : 2

                spacing: 22


                GameCard {

                    gameName: "Fortnite"

                    imageSource: "../../../assets/games/fortnite.png"

                    gameColor: "#2D8CFF"

                }


                GameCard {

                    gameName: "Genshin Impact"

                    imageSource: "../../../assets/games/genshin.png"

                    gameColor: "#8A5CFF"

                }


                GameCard {

                    gameName: "eFootball"

                    imageSource: "../../../assets/games/efootball.png"

                    gameColor: "#00B894"

                }


                GameCard {

                    gameName: "Free Fire"

                    imageSource: "../../../assets/games/freefire.png"

                    gameColor: "#FF9F1C"

                }


                GameCard {

                    gameName: "PUBG Mobile"

                    imageSource: "../../../assets/games/pubg.png"

                    gameColor: "#F5C542"

                }


                GameCard {

                    gameName: "Call of Duty Mobile"

                    imageSource: "../../../assets/games/callofduty.png"

                    gameColor: "#FF4D4D"

                }


                GameCard {

                    gameName: "Grand Theft Auto"

                    imageSource: "../../../assets/games/gta.png"

                    gameColor: "#9B59B6"

                }

            }

        }

    }

}
