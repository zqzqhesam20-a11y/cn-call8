import QtQuick
import QtQuick.Controls
import QtQuick.Layouts
import "pages"

ApplicationWindow {

    id: window

    visible: true

    width: 1500
    height: 900

    minimumWidth: 1100
    minimumHeight: 700

    title: "KAFIA NET CONTROL PRO"

    color: "#070910"

    property string activePage: "الألعاب"


    Row {

        anchors.fill: parent

        spacing: 0


        // =========================================================
        // SIDEBAR
        // =========================================================

        Rectangle {

            width: 240

            height: parent.height

            color: "#0B0E16"


            Column {

                anchors.fill: parent

                anchors.margins: 18

                spacing: 10


                // BRAND
                Rectangle {

                    width: parent.width

                    height: 75

                    color: "transparent"


                    Column {

                        anchors.left: parent.left

                        anchors.verticalCenter: parent.verticalCenter

                        spacing: 2


                        Text {

                            text: "KAFIA NET"

                            color: "#00D9FF"

                            font.pixelSize: 27

                            font.bold: true
                        }


                        Text {

                            text: "CONTROL PRO"

                            color: "#737B8F"

                            font.pixelSize: 13

                            font.bold: true
                        }

                    }

                }


                Rectangle {

                    width: parent.width

                    height: 1

                    color: "#202532"

                }


                Item {

                    width: 1

                    height: 8

                }


                // =================================================
                // NAVIGATION BUTTONS
                // =================================================

                Repeater {

                    model: [

                        { title: "🎮  الألعاب", page: "الألعاب" },

                        { title: "📂  نقل الملفات", page: "نقل الملفات" },

                        { title: "📦  التثبيت", page: "التثبيت" },

                        { title: "📜  سجل النقل", page: "سجل النقل" },

                        { title: "💾  التخزين", page: "التخزين" },

                        { title: "⚙  الإعدادات", page: "الإعدادات" }

                    ]


                    delegate: Rectangle {

                        width: parent.width

                        height: 48

                        radius: 10

                        color: window.activePage === modelData.page
                               ? "#102C38"
                               : "transparent"


                        Rectangle {

                            visible: window.activePage === modelData.page

                            width: 3

                            height: 28

                            radius: 2

                            anchors.left: parent.left

                            anchors.verticalCenter: parent.verticalCenter

                            color: "#00D9FF"

                        }


                        Text {

                            anchors.fill: parent

                            anchors.leftMargin: 18

                            anchors.rightMargin: 10

                            verticalAlignment: Text.AlignVCenter

                            text: modelData.title

                            color: window.activePage === modelData.page
                                   ? "#FFFFFF"
                                   : "#9AA2B3"

                            font.pixelSize: 15

                            font.bold: window.activePage === modelData.page

                        }


                        MouseArea {

                            anchors.fill: parent

                            hoverEnabled: true

                            onClicked: {

                                window.activePage = modelData.page

                            }

                        }

                    }

                }


                Item {

                    width: 1

                    height: 1

                }


                // =================================================
                // SIDEBAR STATUS
                // =================================================

                Rectangle {

                    width: parent.width

                    height: 110

                    radius: 14

                    color: "#0F141E"

                    border.width: 1

                    border.color: "#1E2634"


                    Column {

                        anchors.fill: parent

                        anchors.margins: 14

                        spacing: 8


                        Text {

                            text: "حالة النظام"

                            color: "#7E879A"

                            font.pixelSize: 12

                        }


                        Row {

                            spacing: 8


                            Rectangle {

                                width: 9

                                height: 9

                                radius: 5

                                color: "#27D17F"

                                anchors.verticalCenter: parent.verticalCenter

                            }


                            Text {

                                text: "النظام يعمل"

                                color: "#D9E0EC"

                                font.pixelSize: 13

                            }

                        }


                        Text {

                            text: "KAFIA NET CONTROL PRO"

                            color: "#4F596C"

                            font.pixelSize: 10

                        }

                    }

                }


                Item {

                    width: 1

                    height: 1

                }


                Text {

                    width: parent.width

                    text: "هشام الريمي"

                    color: "#3F4757"

                    horizontalAlignment: Text.AlignCenter

                    font.pixelSize: 11

                }

            }

        }


        // =========================================================
        // MAIN AREA
        // =========================================================

        Rectangle {

            width: parent.width - 240

            height: parent.height

            color: "#070910"


            Column {

                anchors.fill: parent

                spacing: 0


                // =================================================
                // TOP HEADER
                // =================================================

                Rectangle {

                    width: parent.width

                    height: 108

                    color: "#0B0E16"


                    RowLayout {

                        anchors.fill: parent

                        anchors.leftMargin: 30

                        anchors.rightMargin: 30

                        spacing: 18


                        // PAGE TITLE

                        ColumnLayout {

                            Layout.fillWidth: true

                            spacing: 3


                            Text {

                                text: window.activePage

                                color: "#FFFFFF"

                                font.pixelSize: 28

                                font.bold: true

                            }


                            Text {

                                text: "إدارة ونقل ألعاب الأجهزة بسهولة وسرعة"

                                color: "#737C90"

                                font.pixelSize: 13

                            }

                        }


                        // =================================================
                        // WIRELESS STATUS
                        // =================================================

                        Rectangle {

                            Layout.preferredWidth: 155

                            Layout.preferredHeight: 58

                            radius: 12

                            color: "#0E171C"

                            border.width: 1

                            border.color: "#193642"


                            Column {

                                anchors.fill: parent

                                anchors.margins: 10

                                spacing: 3


                                Text {

                                    text: "WIRELESS"

                                    color: "#00D9FF"

                                    font.pixelSize: 12

                                    font.bold: true

                                }


                                Row {

                                    spacing: 6


                                    Rectangle {

                                        width: 7

                                        height: 7

                                        radius: 4

                                        color: "#27D17F"

                                        anchors.verticalCenter: parent.verticalCenter

                                    }


                                    Text {

                                        text: "متصل"

                                        color: "#B9C3D2"

                                        font.pixelSize: 11

                                    }

                                }

                            }

                        }


                        // =================================================
                        // USB STATUS
                        // =================================================

                        Rectangle {

                            Layout.preferredWidth: 145

                            Layout.preferredHeight: 58

                            radius: 12

                            color: "#10141D"

                            border.width: 1

                            border.color: "#242B39"


                            Column {

                                anchors.fill: parent

                                anchors.margins: 10

                                spacing: 3


                                Text {

                                    text: "USB"

                                    color: "#FFFFFF"

                                    font.pixelSize: 12

                                    font.bold: true

                                }


                                Row {

                                    spacing: 6


                                    Rectangle {

                                        width: 7

                                        height: 7

                                        radius: 4

                                        color: "#F0B44D"

                                        anchors.verticalCenter: parent.verticalCenter

                                    }


                                    Text {

                                        text: "جاهز"

                                        color: "#B9C3D2"

                                        font.pixelSize: 11

                                    }

                                }

                            }

                        }


                        // =================================================
                        // REFRESH
                        // =================================================

                        Rectangle {

                            Layout.preferredWidth: 48

                            Layout.preferredHeight: 48

                            radius: 12

                            color: "#10141D"

                            border.width: 1

                            border.color: "#242B39"


                            Text {

                                anchors.centerIn: parent

                                text: "↻"

                                color: "#AAB3C3"

                                font.pixelSize: 23

                            }


                            MouseArea {

                                anchors.fill: parent

                                cursorShape: Qt.PointingHandCursor

                                onClicked: {

                                    console.log("REFRESH REQUESTED")

                                }

                            }

                        }


                        // =================================================
                        // SETTINGS
                        // =================================================

                        Rectangle {

                            Layout.preferredWidth: 48

                            Layout.preferredHeight: 48

                            radius: 12

                            color: "#10141D"

                            border.width: 1

                            border.color: "#242B39"


                            Text {

                                anchors.centerIn: parent

                                text: "⚙"

                                color: "#AAB3C3"

                                font.pixelSize: 19

                            }


                            MouseArea {

                                anchors.fill: parent

                                cursorShape: Qt.PointingHandCursor

                                onClicked: {

                                    window.activePage = "الإعدادات"

                                }

                            }

                        }

                    }

                }


                // =================================================
                // CONTENT
                // =================================================

                Item {

                    width: parent.width

                    height: parent.height - 108


                    Dashboard {

                        anchors.fill: parent

                    }

                }

            }

        }

    }

}
